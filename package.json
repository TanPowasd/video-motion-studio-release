{
  "name": "vmotion",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Local programmable video workstation with an external-agent toolchain",
  "main": "dist/desktop/main.cjs",
  "license": "Apache-2.0",
  "bin": {
    "vmotion": "dist/cli/index.mjs"
  },
  "exports": {
    "./sdk": {
      "types": "./dist/types/sdk/index.d.ts",
      "import": "./dist/sdk/index.mjs"
    }
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts serve --project examples/science --port 4318",
    "dev:ui": "vite --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "cli": "tsx src/cli/index.ts",
    "build": "tsc --noEmit && vite build && vite build --config vite.agent.config.ts && tsx scripts/build.ts",
    "dev:agent": "vite --config vite.agent.config.ts --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-runner.mjs all",
    "native:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "native:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-native.ps1",
    "package:dir": "npm run build && tsx scripts/package.ts",
    "format": "prettier --write src scripts tests *.ts *.json",
    "test:fast": "node scripts/test-runner.mjs fast",
    "test:integration": "node scripts/test-runner.mjs integration",
    "test:acceptance": "node scripts/test-runner.mjs acceptance",
    "test:coverage": "node scripts/test-runner.mjs fast --coverage"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "@napi-rs/canvas": "1.0.10",
    "@types/node": "^24.19.1",
    "@xmldom/xmldom": "0.9.12",
    "ag-psd": "^31.0.2",
    "chokidar": "^4.0.3",
    "commander": "^14.0.0",
    "diff": "^8.0.2",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.3",
    "mathjax-full": "^3.2.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "semver": "7.8.5",
    "typescript": "^5.9.3",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/semver": "7.8.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "electron": "44.5.1",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  }
}
